{
	"name": "@savvy-web/silk-integration",
	"version": "0.0.0",
	"private": true,
	"description": "A private repository for GitHub-related tools and utilities.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/silk-integration.git"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build --log-order=grouped --log-prefix=none",
		"ci:build": "CI=\"true\" turbo run build --log-order=grouped --log-prefix=none",
		"ci:test": "CI=\"true\" vitest run --coverage",
		"ci:version": "savvy changeset version && biome format --write .",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 '**/*.{md,mdx}' --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2  --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"reset": "node lib/configs/hard-reset.ts",
		"test": "vitest run",
		"test:coverage": "vitest run",
		"test:watch": "vitest --watch",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped"
	},
	"devDependencies": {
		"@effected/plugin": "catalog:effected",
		"@okfit/plugin": "^0.5.29",
		"@savvy-web/silk": "^5.0.0",
		"@types/node": "catalog:effected:build",
		"@types/react": "catalog:effected:build",
		"@types/react-dom": "catalog:effected:build",
		"@vitest-agent/plugin": "^6.0.5",
		"react": "catalog:effected:build",
		"react-dom": "catalog:effected:build",
		"tsx": "catalog:effected:build",
		"typescript": "catalog:effected:build"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.17.0",
			"onFail": "download"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.13.0",
				"onFail": "ignore"
			}
		]
	}
}
